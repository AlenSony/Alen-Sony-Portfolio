{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "reactbits-starter": {
      "url": "https://api.reactbits.dev/r/starter",
      "headers": {
        "Authorization": "Bearer $REACTBITS_LICENSE_KEY"
      }
    },
    "reactbits-pro": {
      "url": "https://api.reactbits.dev/r/pro",
      "headers": {
        "Authorization": "Bearer $REACTBITS_LICENSE_KEY"
      }
    }
  }
}
